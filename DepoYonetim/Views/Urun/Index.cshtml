@model List<DepoYonetim.Models.Urun>

@{ ViewData["Title"] = "Ürünler"; }

<h1>Ürünler</h1>
<p><a href="/Urun/Ekle">+ Yeni Ürün Ekle</a></p>

<table class="table table-bordered">
    <thead>
        <tr><th>Id</th><th>Ad</th><th>Barkod</th><th>Birim</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Ad</td>
                <td>@u.Barkod</td>
                <td>@u.Birim</td>
                <td><a href="/Urun/Sil/@u.Id">Sil</a></td>
            </tr>
        }
    </tbody>
</table>