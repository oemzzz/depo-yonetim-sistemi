@{ ViewData["Title"] = "Kullanıcı Ekle"; }

<h1>Yeni Kullanıcı</h1>

<form method="post" action="/Kullanici/Ekle">
    <div class="mb-3">
        <label>Ad Soyad</label>
        <input type="text" name="AdSoyad" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a href="/Kullanici" class="btn btn-secondary">Vazgeç</a>
</form>